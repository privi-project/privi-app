{
  "cli": {
    "version": ">= 13.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildArtifactPaths": [
          "android/app/build/outputs/**/*.{apk,aab}",
          "android/app/build/outputs/mapping/**/mapping.txt"
        ]
      }
    }
  },
  "submit": {
    "production": {}
  }
}
