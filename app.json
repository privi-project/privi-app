{
  "expo": {
    "name": "Privi",
    "slug": "privi-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "privi",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "info.privi.app",
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Privi uses your location to show you nearby Member Benefits.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Privi uses your location to show you nearby Member Benefits."
      }
    },
    "android": {
      "package": "info.privi.app",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBcDzhnJa2Fo4VD4j3kgrAHaF3gFesDkL4"
        }
      },
      "adaptiveIcon": {
        "backgroundColor": "#6FA7A1",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#6FA7A1",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 130
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Privi to access your location to show nearby Member Benefits."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1d9f9f98-8caf-482f-ad2e-4048bbbd938e"
      }
    },
    "owner": "paul_privi"
  }
}
